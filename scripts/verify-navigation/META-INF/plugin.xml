<idea-plugin>
  <id>verify.cucumber.navigation</id>
  <name>Cucumber navigation probe (verification only)</name>
  <vendor>verify</vendor>
  <idea-version since-build="262" />
  <depends>com.intellij.modules.platform</depends>
  <depends>io.github.fangzhengjie.cucumber</depends>
  <depends>intellij.testRunner.plugin</depends>
  <extensions defaultExtensionNs="com.intellij">
    <appStarter id="cucumberNavigationProbe" implementation="verify.NavigationProbe" />
    <!-- feature: unused -->
    <appStarter id="cucumberUnusedProbe" implementation="verify.UnusedProbe" />
  </extensions>
</idea-plugin>
